# Snyk (https://snyk.io) policy file
version: v1.25.0
ignore:
  SNYK-JS-JSYAML-18313070:
    - '*':
        reason: >-
          @yarnpkg/parsers (pulled in via @backstage/cli-node) requires js-yaml@^3.x
          and uses the safeLoad() API that was removed in js-yaml v4+. Upgrading to
          v4.3.1+ via resolution would break Yarn's own lockfile parser. This is a
          dev-only transitive dependency not present in production builds. The v4
          path is fixed via the js-yaml@4.3.1 resolution override.
        expires: '2027-07-27T00:00:00.000Z'
  SNYK-JS-REACTDEVUTILS-17890708:
    - '*':
        reason: >-
          No fix available upstream. react-dev-utils is a dev-only transitive
          dependency pulled in by @backstage/cli-module-build and is not
          present in production builds. The vulnerable openBrowser helper
          requires local filesystem access to exploit and is not reachable
          from untrusted input in this project.
        expires: '2027-07-12T00:00:00.000Z'
patch: {}
